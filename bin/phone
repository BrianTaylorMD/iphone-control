#!/usr/bin/env python3
"""phone — client for phoned (the persistent developer connection to your iPhone).

  phone start [--remote [HOST]] [--network] [--no-vnc]   start phoned in the background (phone paired, Developer Mode on)
  phone stop | status
  phone "tap 220 480" "wait 400" "type hello" "shot"     run steps in order over one connection

Prints one JSON line per step: {"ok": true, "cmd": "tap", "ms": 61, ...}. A chain stops at the first failed step.
Text in type/paste may contain newlines (pass them inside the quoted step).
"""
import json
import os
import socket
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
CACHE = Path.home() / ".cache/iphone"
SOCK = CACHE / "phoned.sock"
LOG = CACHE / "phoned.log"
SHOTS = CACHE / "shots"
VNC_PASSWORD_FILE = CACHE / "vnc-password"
# pymobiledevice3's own interpreter (uv tool install pymobiledevice3); override with PHONE_PY.
PY = Path(os.environ.get("PHONE_PY", Path.home() / ".local/share/uv/tools/pymobiledevice3/bin/python"))


def pids() -> list:
    # Only this user's phoned (never someone else's process that happens to match).
    out = subprocess.run(["pgrep", "-u", str(os.getuid()), "-f", f"{HERE / 'phoned.py'} serve"],
                         capture_output=True, text=True).stdout
    return [int(p) for p in out.split()]


def send(steps: list) -> int:
    s = socket.socket(socket.AF_UNIX)
    s.connect(str(SOCK))
    f = s.makefile("rw")
    rc = 0
    for step in steps:
        if not step.strip():
            print(json.dumps({"ok": False, "error": "empty step"})); return 1
        f.write(json.dumps(step) + "\n"); f.flush()      # JSON string: newlines in text survive the line protocol
        reply = f.readline().strip()
        print(reply)
        if not json.loads(reply).get("ok"):
            rc = 1
            break
    s.close()
    return rc


def stop() -> int:
    for p in pids(): os.kill(p, 15)
    for _ in range(50):  # the daemon tears down its stream and tunnel before exiting
        if not pids(): break
        time.sleep(0.1)
    for p in pids(): os.kill(p, 9)
    removed = 0
    if SHOTS.exists():   # screenshots never outlive the session that took them
        for f in SHOTS.iterdir():
            f.unlink(missing_ok=True); removed += 1
    for f in (SOCK, VNC_PASSWORD_FILE):
        f.unlink(missing_ok=True)
    print(f"stopped (deleted {removed} screenshots)"); return 0


def start(args: list) -> int:
    if pids():
        try:
            return send(["ping"])
        except OSError:
            print(json.dumps({"ok": False, "error": "phoned is running but not answering; run `phone stop` first"})); return 1
    CACHE.mkdir(parents=True, exist_ok=True)
    os.chmod(CACHE, 0o700)
    log = os.open(LOG, os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    proc = subprocess.Popen([str(PY), str(HERE / "phoned.py"), "serve", *args], stdout=log, stderr=log,
                            start_new_session=True)
    os.close(log)
    # --remote retries for up to ~50 s while the phone gets onto Wi-Fi, so wait longer than that.
    deadline = time.monotonic() + (90 if "--remote" in args else 30)
    while time.monotonic() < deadline:
        time.sleep(0.2)
        if proc.poll() is not None:
            break
        if SOCK.exists():
            try:
                return send(["ping"])
            except OSError:
                pass
    if proc.poll() is None:
        proc.terminate()   # don't leave a half-started daemon behind
    print(json.dumps({"ok": False, "error": "phoned did not start (phone unlocked? on Wi-Fi? see log)", "log": LOG.read_text()[-800:]}))
    return 1


def main() -> int:
    os.umask(0o077)   # everything this tool creates is readable by your user only
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__); return 0
    if args[0] == "status":
        print(json.dumps({"running": bool(pids()), "pids": pids(), "socket": SOCK.exists()})); return 0
    if args[0] == "stop":
        return stop()
    if args[0] == "start":
        return start(args[1:])
    if not SOCK.exists() or not pids():
        print(json.dumps({"ok": False, "error": "phoned not running: run `phone start` (phone unlocked)"})); return 1
    return send(args)


if __name__ == "__main__":
    sys.exit(main())
